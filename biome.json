{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "next/src/**/*.ts",
      "next/src/**/*.tsx"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "nursery": "error",
      "correctness": {
        "useQwikValidLexicalScope": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "next/src/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off",
            "noSolidDestructuredProps": "off"
          },
          "style": {
            "noJsxLiterals": "off"
          },
          "suspicious": {
            "noReactSpecificProps": "off"
          },
          "performance": {
            "useSolidForComponent": "off"
          }
        }
      }
    },
    {
      "includes": [
        "next/src/platform/webhid/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off",
            "noExcessiveLinesPerFile": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": [
        "next/src/**/*.test.ts",
        "next/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          },
          "nursery": {
            "useExplicitType": "off",
            "useExplicitReturnType": "off"
          }
        }
      }
    }
  ]
}
