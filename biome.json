{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "next/src/**/*.ts",
      "next/src/**/*.tsx"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "nursery": "error"
    }
  },
  "overrides": [
    {
      "includes": [
        "next/src/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "style": {
            "noJsxLiterals": "off"
          },
          "suspicious": {
            "noReactSpecificProps": "off"
          },
          "performance": {
            "useSolidForComponent": "off"
          }
        }
      }
    }
  ]
}
